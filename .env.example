# Posta - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Gemini API (Optional - for AI features)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Plus Pass bank transfer account (publicly shown in checkout modal)
VITE_PLUS_BANK_NAME=your_bank_name
VITE_PLUS_BANK_ACCOUNT=your_account_number
VITE_PLUS_BANK_HOLDER=your_account_holder
VITE_PLUS_BANK_CONTACT=support@example.com

# Emulators (Optional - for local development)
# VITE_USE_EMULATORS=true
